# Builds only the iOS IPA, with the iOS 27.1+ SDK so it fills iPhone Duo's inner screen.
name: iOS IPA only

on:
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/ios-only.yml'

jobs:
  ios:
    name: iOS IPA (unsigned)
    runs-on: xcode-27
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

      # Picks the newest Xcode 27 on the runner, so a 27.0 default doesn't win over 27.1+.
      - name: Select Xcode
        run: |
          XCODE="$(ls -d /Applications/Xcode_27*.app 2>/dev/null | sort -V | tail -1)"
          sudo xcode-select -switch "${XCODE:-/Applications/Xcode.app}"
          xcodebuild -version
          echo "iphoneos SDK $(xcrun --sdk iphoneos --show-sdk-version)"

      - name: Require the iOS 27.1 SDK
        run: |
          sdk="$(xcrun --sdk iphoneos --show-sdk-version)"
          printf '%s\n27.1\n' "$sdk" | sort -V -C -r || { echo "::error::iOS SDK $sdk is older than 27.1; the app would be letterboxed on iPhone Duo"; exit 1; }

      - name: Install tools
        run: |
          rustup target add aarch64-apple-ios
          brew install ninja

      - name: Build the core
        run: platforms/ios/scripts/build-ios-core.sh device

      - name: Build the IPA
        run: ./platforms/ios/scripts/build-ios-ipa.sh

      - name: Upload IPA
        uses: actions/upload-artifact@v4
        with:
          name: ARMSX2-iOS-Duo
          path: platforms/ios/build/device/ARMSX2-iOS-unsigned.ipa
          if-no-files-found: error